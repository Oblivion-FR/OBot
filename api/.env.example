# Copy to .env and fill in. Only read from the working directory.

# Key from https://developer.hypixel.net/dashboard
HYPIXEL_API_KEY=

# Optional: address the API listens on (default 127.0.0.1:8090)
API_BIND=
# Optional: SQLite database location (default sqlite://hytools.db)
DATABASE_URL=
# Optional: log filter, like `info` or `hytools_api=debug,info` (default info)
RUST_LOG=
