# Copy to .env and fill in. Roles and rules are configured per server in the web panel.
# Per environment overrides go in .env.development or .env.production, which only need the
# variables that differ: see docs/setup.md. Pick the environment with OBOT_ENV (defaults to
# development for `cargo run`, production for `cargo run --release`).

# From https://discord.com/developers/applications → your app
# Bot → Token
DISCORD_TOKEN=
# OAuth2 → Client Secret. Also add `<PANEL_URL>/callback` to OAuth2 → Redirects
DISCORD_CLIENT_SECRET=
# Key from https://developer.hypixel.net/dashboard
HYPIXEL_API_KEY=

# Optional: address the panel listens on (default 127.0.0.1:8081)
PANEL_BIND=
# Optional: public URL of the panel, as typed in the browser (default http://<PANEL_BIND>)
PANEL_URL=
# Optional: SQLite database location (default sqlite://obot.db)
DATABASE_URL=
# Optional: hours between refreshes of every verified member (default 3, 0 turns them off)
RESYNC_INTERVAL_HOURS=
# Optional: register commands in this guild only, which is instant (useful while developing)
GUILD_ID=
