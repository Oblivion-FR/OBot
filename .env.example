# Copy to .env and fill in

# Bot token from https://discord.com/developers/applications → Bot
DISCORD_TOKEN=
# Key from https://developer.hypixel.net/dashboard
HYPIXEL_API_KEY=
# Role affected by /verify (Developer Mode → right click the role → Copy Role ID)
UNVERIFIED_ROLE_ID=
VERIFIED_ROLE_ID=
# Optional: register commands in this guild only, which is instant (useful while developing)
GUILD_ID=
